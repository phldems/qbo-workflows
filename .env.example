# ==============================================
# Check Processing Workflow - Configuration
# ==============================================

# Email Configuration (Mailcow IMAP/SMTP)
# ----------------------------------------------
IMAP_SERVER=mail.yourdomain.com
IMAP_PORT=993
IMAP_USE_SSL=true

SMTP_SERVER=mail.yourdomain.com
SMTP_PORT=465
SMTP_USE_SSL=true

EMAIL_USERNAME=checks@yourdomain.com
EMAIL_PASSWORD=your_secure_password

# Email folders for organization
EMAIL_INBOX_FOLDER=INBOX
EMAIL_PROCESSED_FOLDER=Processed
EMAIL_FAILED_FOLDER=Failed
EMAIL_MANUAL_REVIEW_FOLDER=ManualReview
EMAIL_DUPLICATES_FOLDER=Duplicates

# Email polling interval (seconds)
IMAP_POLL_INTERVAL=120

# QuickBooks Online Configuration
# ----------------------------------------------
# Get these from: https://developer.intuit.com/app/developer/myapps
QBO_CLIENT_ID=your_qbo_client_id
QBO_CLIENT_SECRET=your_qbo_client_secret

# Redirect URI - MUST match what's configured in your QuickBooks app
# In Developer Portal → Keys & OAuth → Add this exact URI
# Default uses QuickBooks OAuth platform (works without localhost)
QBO_REDIRECT_URI=https://oauth.platform.intuit.com/op/v1

QBO_ENVIRONMENT=production  # or 'sandbox' for testing

# Realm ID (Company ID) - obtained during OAuth authorization
QBO_REALM_ID=your_realm_id

# Refresh token (stored after first OAuth authorization)
# Leave empty on first run, will be populated automatically
QBO_REFRESH_TOKEN=

# QuickBooks entity IDs (lookup these in your QBO account)
QBO_PAYMENT_METHOD_ID=1  # ID for "Check" payment method
QBO_DEPOSIT_ACCOUNT_ID=  # ID for "Undeposited Funds" or target bank account
QBO_INCOME_ITEM_ID=      # ID for income account/item for check deposits

# Google Cloud / Vertex AI Configuration
# ----------------------------------------------
# Path to service account JSON key file
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Vertex AI Project Configuration
VERTEX_AI_PROJECT_ID=your-gcp-project-id
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_MODEL=gemini-2.5-pro  # Or gemini-2.5-flash for faster/cheaper

# OCR Confidence Thresholds (0-100)
# ----------------------------------------------
OCR_CONFIDENCE_THRESHOLD=85     # Minimum confidence to auto-process
MANUAL_REVIEW_THRESHOLD=70      # Below this, send for manual review

# Check Detection Algorithm Parameters
# ----------------------------------------------
# These control the computer vision algorithm that finds and extracts checks from scanned images.
# Defaults work well for most cases - only modify if you need to adjust detection behavior.

# Resolution for rendering PDF pages to images (default: 300)
# Higher values (600) = better quality but slower, Lower (150) = faster but lower quality
CHECK_DETECTOR_DPI=300

# Inter-Quartile Range multiplier for identifying gaps between checks (default: 1.5)
# Increase if checks too close together are being merged, decrease if gaps within checks cause splits
CHECK_DETECTOR_IQR_FACTOR=1.5

# Z-score threshold for filtering noise/smudges from actual check content (default: 2.5)
# Lower if valid check content is excluded, raise if too much noise is included
CHECK_DETECTOR_OUTLIER_THRESHOLD=2.5

# Percentage to expand detected bounding boxes to avoid cutting edges (default: 4.0)
# Increase if check edges are cropped, decrease if too much white space included
CHECK_DETECTOR_EXPAND_PERCENT=4.0

# Minimum width/height for something to be considered a check - filters tiny noise (default: 300)
# At 300 DPI, this equals 1 inch minimum. Lower for small checks, raise to filter noise
MIN_CHECK_DIMENSION_PX=300

# Minimum pixel area for connected components - filters dust/specs (default: 80)
# Lower if small text is being lost, raise if too much noise appears
MIN_COMPONENT_AREA_PX=80

# Maximum height for MICR line (magnetic ink numbers at bottom of check) (default: 450)
# At 300 DPI, this equals 1.5 inches. Rarely needs adjustment.
MICR_LINE_MAX_HEIGHT_PX=450

# Maximum gap between check body and MICR line to merge them together (default: 600)
# At 300 DPI, this equals 2 inches. Increase if MICR detached, decrease if unrelated content merged
MICR_LINE_MAX_GAP_PX=600

# Starting confidence score for detected checks, adjusted based on components (default: 50.0)
# Range: 0-100. Affects confidence thresholds for auto-processing
BASE_DETECTION_CONFIDENCE=50.0

# Database Configuration
# ----------------------------------------------
DATABASE_PATH=./data/checks.db
DATABASE_ECHO=false  # Set to true for SQL query logging

# Application Settings
# ----------------------------------------------
# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=./logs/check_processor.log
LOG_ROTATION=10 MB
LOG_RETENTION=30 days

# Retry configuration
MAX_RETRIES=3
RETRY_DELAY=5  # seconds
RETRY_BACKOFF_MULTIPLIER=2

# Processing
MAX_CONCURRENT_PROCESSING=5
IMAGE_TEMP_DIR=./data/temp

# Security
# ----------------------------------------------
# Encryption key for sensitive data in database (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=your_32_byte_hex_encryption_key

# Development/Testing
# ----------------------------------------------
# Set to true to enable debug features
DEBUG=false

# Skip email sending in test mode
DRY_RUN=false

# Test email address for notifications
# Primary notification recipient - set this to your checks inbox so
# threaded replies land in the correct mailbox.
NOTIFICATION_RECIPIENT=checks@yourdomain.com

# Optional test override (leave empty for normal operation)
# TEST_EMAIL_RECIPIENT=admin@yourdomain.com

# Test Sample Files (Optional - for integration tests only)
# ----------------------------------------------
# These are ONLY needed for running integration tests locally - NOT for production.
# Tests will skip gracefully if not configured, so you can safely leave these commented out.
#
# Point these to actual check PDF files if you want to test the detection algorithm:

# Path to a PDF with exactly 1 check on the page
# Used by: tests/test_check_detection_integration.py::test_single_check_detection
# Tests: Algorithm correctly identifies single check without splitting it
# SINGLE_CHECK_SAMPLE_PDF=/path/to/sample-single-check.pdf

# Path to a PDF with 2+ checks on the page
# Used by: tests/test_check_detection_integration.py::test_multi_check_detection
# Tests: Algorithm correctly separates multiple checks on one page
# MULTI_CHECK_SAMPLE_PDF=/path/to/sample-multi-check.pdf

# Alternative single-check sample for additional test coverage
# Tests: Different check formats and edge cases
# ALTERNATE_SINGLE_CHECK_SAMPLE_PDF=/path/to/alternate-check.pdf

# Demo check used for attachment testing
# Tests: QuickBooks attachment integration
# DEMO_CHECK_SAMPLE_PDF=/path/to/demo-check.pdf

# Comma-separated list of multiple check PDFs for batch testing
# Tests: Comprehensive detection algorithm validation across different formats
# Format: /path/to/check1.pdf,/path/to/check2.pdf,/path/to/check3.pdf
# CHECK_DETECTION_SAMPLE_PDFS=/path/to/check1.pdf,/path/to/check2.pdf,/path/to/check3.pdf
